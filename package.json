{
  "name": "jt-express",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-jt-express",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "import:content": "node --env-file-if-exists=.env.local scripts/import-content.mjs",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^13.3.0",
    "i18next": "^27.1.2",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
